# Dipakai oleh docker-compose.yml di folder yang sama (Docker Compose otomatis
# membaca file bernama ".env" persis di sebelah docker-compose.yml untuk
# substitusi ${VAR}). File ini BEDA dengan backend/.env.example, yang dipakai
# kalau menjalankan backend langsung dengan `npm run dev` TANPA Docker.
#
# Cara pakai: `cp .env.example .env` lalu ganti nilai di bawah dengan nilai
# acak milik sendiri sebelum `docker compose up` (ditambahkan Sesi 9 - lihat
# catatan panjang di docker-compose.yml soal kenapa ini sekarang WAJIB diisi,
# bukan lagi punya nilai default yang dibiarkan apa adanya).

POSTGRES_PASSWORD=change_this_to_a_long_random_password
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_API_KEY=change_this_to_a_long_random_admin_key

# Opsional - kosongkan untuk izinkan semua origin (default, cocok untuk coba-coba
# lokal). Isi domain frontend/app resmi (pisah koma kalau lebih dari satu)
# sebelum deploy sungguhan. Lihat backend/src/config/corsOrigin.js.
CORS_ORIGIN=*
